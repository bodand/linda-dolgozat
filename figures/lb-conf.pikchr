
Src1: file color 0x123456 "src1.c"
move .65

Src2: file color 0xFF0021 "src2.c"
move .65

Src3: file color 0x98AF23 "src3.c"
move .65

Src4: file color 0x77BBEE "src4.c"

line color Src1.color right .2 from Src1.e
oval color Src1.color "CC" fit
arrow color Src1.color down .2 from last.s
Obj1: box color Src1.color width Src1.width "src1.o"

line color Src2.color right .2 from Src2.e
oval color Src2.color "CC" fit
arrow color Src2.color down .2 from last.s
Obj2: box color Src2.color width Src2.width "src2.o"

line color Src3.color right .2 from Src3.e
oval color Src3.color "CC" fit
arrow color Src3.color down .2 from last.s
Obj3: box color Src3.color width Src3.width "src3.o"

line color Src4.color right .2 from Src4.e
oval color Src4.color "CC" fit
arrow color Src4.color down .2 from last.s
Obj4: box color Src4.color width Src4.width "src4.o"

Linker: oval at (Obj1.x + (Obj4.x - Obj1.x)/2, Obj2.y - .6) "LD" fit

line color Obj1.color down .1 from Obj1.s \
    then to Linker.n
line color Obj2.color down .1 from Obj2.s \
    then to Linker.n
line color Obj3.color down .1 from Obj3.s \
    then to Linker.n
line color Obj4.color down .1 from Obj4.s \
    then to Linker.n

right
arrow .3 from Linker.e
Exe: oval thick thick "exec" fit
