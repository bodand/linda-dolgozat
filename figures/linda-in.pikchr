down

TS0: box width .7 height .7 color gray

text with .n at TS0.n "(1, 2, 3)" bold
text "(\"A\", 42)" bold
text "..." big bold
TS0L: text "Linda TS" big bold with .nw at TS0.sw - (.05, -.023)

    text with .w at TS0.ne - (.074, .05) "int x;" ljust big bold monospace
AT: text with .w at TS0.ne - (.324, .18) "in(\"A\", ?x);" ljust big bold monospace
    text with .w at TS0.ne - (.487, .3)  "assert(x == 42);" ljust big bold monospace color gray
    text with .w at TS0.ne - (.732, .42) "assert(!inp(\"A\", ?x));" ljust big bold monospace color gray
    text with .w at TS0.ne - (-.01, .54) "..." ljust big bold monospace color gray

aoffs = .42
arrow <- from (AT.w.x + .08 + aoffs, AT.w.y - .01) to AT.w + (aoffs, -.01) color orange

TS1: box at (1, -.8) width .7 height .7 color gray


    text with .w at TS1.ne - (.074, .05) "int x;" ljust big bold monospace
    text with .w at TS1.ne - (.324, .18) "in(\"A\", ?x);" ljust big bold monospace
    text with .w at TS1.ne - (.487, .3)  "assert(x == 42);" ljust big bold monospace color green
    text with .w at TS1.ne - (.732, .42) "assert(!inp(\"A\", ?x));" ljust big bold monospace color green
AT: text with .w at TS1.ne - (-.01, .54) "..." ljust big bold monospace color gray

aoffs = .03
arrow <- from (AT.w.x + .08 + aoffs, AT.w.y - .01) to AT.w + (aoffs, -.01) color orange

text with .n at TS1.n "(1, 2, 3)" bold
RM: text "(\"A\", 42)" bold color red
text "..." big bold
TS1L: text "Linda TS" big bold with .nw at TS1.sw - (.05, -.023)

line color red from RM.w to RM.e

arc -> from TS0.s - (0, .2) to TS1.w - (.1, 0)
